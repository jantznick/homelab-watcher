# Optional bootstrap — prefer Settings in the web UI after first boot.
# Secrets saved in Settings are stored in SQLite on the data volume (sensitive).

# Resend email (https://resend.com) — also configurable in Settings → Email
RESEND_API_KEY=
DIGEST_FROM=Homelab Watcher <onboarding@resend.dev>
DIGEST_TO=

# Fallback digest schedule if not set in Settings (cron)
DIGEST_CRON=0 9 * * 0
DIGEST_SEND_ALL_CLEAR=true

TZ=America/Chicago

# Fallback poll interval if not set in Settings (seconds)
POLL_INTERVAL_SECONDS=300

DATABASE_PATH=/data/homelab-watcher.db
CONFIG_PATH=/config/config.yaml

# Optional Pi-hole fallback if not set in Settings
PIHOLE_PASSWORD=
PIHOLE_API_TOKEN=
